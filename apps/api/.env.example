# Copy to .env — all vars prefixed ACE_
ACE_DATABASE_URL=postgresql://ace:ace@localhost:5445/ace
# CLI proxy gateway (shared across projects). Paste the shared CLIProxyAPI key:
ACE_LLM_BASE_URL=http://localhost:8317/v1
ACE_LLM_API_KEY=
ACE_LLM_DEFAULT_MODEL=gpt-5.5
# hash = deterministic local embedder (dev/test); proxy = gateway /embeddings
ACE_EMBEDDER=hash
ACE_JWT_SECRET=dev-secret-change-me
ACE_YOUTUBE_API_KEY=
